{
  "name": "The Charleston Atelier",
  "short_name": "Atelier",
  "description": "Your protocol, your schedule, and the atelier \u2014 one tap away.",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F3EBE1",
  "theme_color": "#F3EBE1",
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "_note": "No start_url on purpose. Per the manifest spec it then defaults to the document URL, so a card added to the home screen reopens on that card. Setting it to \".\" saved the bare root instead and the icon opened somebody else."
}

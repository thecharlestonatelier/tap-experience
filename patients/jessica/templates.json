  "injectionStepsSyringe": [
    "Take the vial out of the freezer and let it thaw ~5 minutes",
    "Wipe the top of the vial with alcohol",
    "Draw up to {units} units \u2014 the dashes on the syringe are units",
    "Wipe the skin on your lower stomach with alcohol",
    "Pinch an inch, insert at 90\u00b0 and push the plunger",
    "Remove the needle and place it in a sharps container"
  ],
  "injectionStepsVial": [
    "Take the vial out of the fridge and let it come to room temperature",
    "Wipe the top of the vial with alcohol",
    "Draw up to {units} units \u2014 the dashes on the syringe are units",
    "Wipe the skin on your lower stomach with alcohol",
    "Pinch an inch, insert at 90\u00b0 and push the plunger",

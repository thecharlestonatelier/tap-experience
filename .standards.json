{
  "adapter": "node",
  "test_command": "cd portal && node --test tests/unit/",
  "node_coverage": "portal/node_modules/.bin/c8",
  "mode": "gate",
  "new_function_max": 10,
  "touched": "ratchet",
  "coverage": "coverage.json",
  "coverage_measure": "branch",
  "pin_floor": 70,
  "baseline": ".standards-crap-baseline.json",
  "include": ["portal/**/*.js"],
  "exclude": [
    "portal/node_modules/**",
    "portal/tests/**",
    "portal/.data*/**",
    "portal/studio/**",
    "**/.worktrees/**",
    "**/node_modules/**",
    "**/tests/**"
  ]
}
